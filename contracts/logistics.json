  "info": {
    "title": "logistics service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/location": {
      "post": {
        "operationId": "record_location_location_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocationPingIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Record a GPS location ping (every 30 s while on route)",
        "tags": [
          "logistics"
        ]
      }
    },
    "/my-route": {
      "get": {
        "operationId": "my_route_my_route_get",
        "parameters": [
          {
            "in": "query",
            "name": "pool_date",
            "required": false,
            "schema": {
              "format": "date",
              "title": "Pool Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Today's assigned pool for the authenticated delivery partner",
        "tags": [
          "logistics"
        ]
      }
    },
    "/orders/{order_id}/track": {
      "get": {
        "description": "Where the order is, who brings it and the delivery code. Only the customer of the order\n(and an admin) may see this; anyone else gets 404, as if the order had no route.",
        "operationId": "track_order_orders__order_id__track_get",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Live tracking for a customer order",
        "tags": [
          "logistics"
        ]
      }
    },
    "/pools": {
      "get": {
        "description": "Every pool for `pool_date` with its stops in `seq` order, oldest pool first.",
        "operationId": "list_pools_pools_get",
        "parameters": [
          {
            "description": "Date to list pools for (default: today in India)",
            "in": "query",
            "name": "pool_date",
            "required": false,
            "schema": {
              "description": "Date to list pools for (default: today in India)",
              "format": "date",
              "title": "Pool Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PoolOut"
                  },
                  "title": "Response List Pools Pools Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Saved pools for a given date",
        "tags": [
          "logistics"
        ]
      }
    },
    "/pools/run": {
      "post": {
        "description": "Fetch READY_FOR_DISPATCH orders, cluster them, persist pools, publish pool.assigned.",
        "operationId": "run_pools_pools_run_post",
        "parameters": [
          {
            "description": "Date to pool orders for (default: today in India)",
            "in": "query",
            "name": "pool_date",
            "required": false,
            "schema": {
              "description": "Date to pool orders for (default: today in India)",
              "format": "date",
              "title": "Pool Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolRunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Run the pooling job for a given date",
        "tags": [
          "logistics"
        ]
      }
    },
    "/stops/{stop_id}/arrive": {
      "post": {
        "operationId": "arrive_at_stop_stops__stop_id__arrive_post",
        "parameters": [
          {
            "in": "path",
            "name": "stop_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Stop Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StopOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Mark partner arrival at a stop",
        "tags": [
          "logistics"
        ]
      }
    },
    "/stops/{stop_id}/deliver": {
      "post": {
        "operationId": "confirm_delivery_stops__stop_id__deliver_post",
        "parameters": [
          {
            "in": "path",
            "name": "stop_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Stop Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeliverIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StopOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Complete a DROP stop with photo proof + OTP",
        "tags": [
          "logistics"
        ]
      }
    },
