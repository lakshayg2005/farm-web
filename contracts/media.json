          },
          "isGeoVerified": {
            "description": "False shows an 'unverified' badge",
            "title": "Isgeoverified",
            "type": "boolean"
          },
          "ownerId": {
            "format": "uuid",
            "title": "Ownerid",
            "type": "string"
          },
          "ownerService": {
            "description": "Service that owns the owner, e.g. catalog or land",
            "title": "Ownerservice",
            "type": "string"
          },
          "ownerType": {
            "$ref": "#/components/schemas/OwnerType"
          },
          "processedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processedat"
          },
          "rejectReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rejectreason"
          },
          "sizeBytes": {
            "title": "Sizebytes",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/MediaStatus"
          },
          "thumbUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumburl"
          },
          "uploadedBy": {
            "format": "uuid",
            "title": "Uploadedby",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Public copy without EXIF/GPS; set once READY",
            "title": "Url"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          }
        },
        "required": [
          "id",
          "ownerService",
          "ownerType",
          "ownerId",
          "uploadedBy",
          "status",
          "contentType",
          "sizeBytes",
          "url",
          "thumbUrl",
          "width",
          "height",
          "exifTime",
          "isGeoVerified",
          "geoStatus",
          "distanceM",
          "rejectReason",
          "createdAt",
          "processedAt"
        ],
        "title": "MediaOut",
        "type": "object"
      },
      "MediaPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MediaOut"
            },
            "title": "Items",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "MediaPage",
        "type": "object"
      },
      "MediaStatus": {
        "enum": [
          "PENDING_UPLOAD",
          "PROCESSING",
          "READY",
          "REJECTED",
          "FAILED",
          "DELETED"
        ],
        "title": "MediaStatus",
        "type": "string"
      },
      "OwnerType": {
        "description": "What the photo belongs to; decides which location it is checked against.",
        "enum": [
          "FARM",
          "LISTING",
          "PLOT",
          "RESERVATION",
          "DELIVERY",
          "USER"
        ],
        "title": "OwnerType",
        "type": "string"
      },
      "UploadUrlIn": {
        "properties": {
          "contentType": {
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "title": "Contenttype",
            "type": "string"
          },
          "fileName": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "ownerId": {
            "description": "Id of the farm, listing, plot, reservation, ...",
            "format": "uuid",
            "title": "Ownerid",
            "type": "string"
          },
          "ownerType": {
            "$ref": "#/components/schemas/OwnerType"
          },
          "sizeBytes": {
            "description": "Exact file size (max 5 MB)",
            "exclusiveMinimum": 0.0,
            "maximum": 5242880.0,
            "title": "Sizebytes",
            "type": "integer"
          }
        },
        "required": [
          "ownerType",
          "ownerId",
          "contentType",
          "sizeBytes"
        ],
        "title": "UploadUrlIn",
        "type": "object"
      },
      "UploadUrlOut": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Send exactly these headers with the PUT",
            "title": "Headers",
            "type": "object"
          },
          "mediaId": {
            "format": "uuid",
            "title": "Mediaid",
            "type": "string"
          },
          "method": {
            "const": "PUT",
            "default": "PUT",
            "title": "Method",
            "type": "string"
          },
          "uploadUrl": {
            "description": "PUT the file body here before `expiresAt`",
            "title": "Uploadurl",
            "type": "string"
          }
        },
        "required": [
          "mediaId",
          "uploadUrl",
          "headers",
          "expiresAt"
        ],
        "title": "UploadUrlOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
