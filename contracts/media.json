{
  "components": {
    "schemas": {
      "GeoPoint": {
        "properties": {
          "coordinates": {
            "description": "[lng, lat]",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "const": "Point",
            "default": "Point",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "coordinates"
        ],
        "title": "GeoPoint",
        "type": "object"
      },
      "GeoStatus": {
        "enum": [
          "PENDING",
          "VERIFIED",
          "TOO_FAR",
          "NO_GPS",
          "NO_REFERENCE",
          "NOT_APPLICABLE"
        ],
        "title": "GeoStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MediaInternalOut": {
        "description": "For other services only: includes where the photo was taken and a short-lived URL to\nthe original.",
        "properties": {
          "contentType": {
            "title": "Contenttype",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "distanceM": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Metres from the farm / plot (0 = inside it)",
            "title": "Distancem"
          },
          "exifTime": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Capture time from EXIF, if present (UTC)",
            "title": "Exiftime"
          },
          "geoStatus": {
            "$ref": "#/components/schemas/GeoStatus",
            "description": "Why it is (not) verified"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "isGeoVerified": {
            "description": "False shows an 'unverified' badge",
            "title": "Isgeoverified",
            "type": "boolean"
          },
          "originalUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Originalurl"
          },
          "ownerId": {
            "format": "uuid",
            "title": "Ownerid",
            "type": "string"
          },
          "ownerService": {
            "description": "Service that owns the owner, e.g. catalog or land",
            "title": "Ownerservice",
            "type": "string"
          },
          "ownerType": {
            "$ref": "#/components/schemas/OwnerType"
          },
          "processedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processedat"
          },
          "rejectReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rejectreason"
          },
          "sizeBytes": {
            "title": "Sizebytes",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/MediaStatus"
          },
          "takenAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              },
              {
                "type": "null"
              }
            ],
            "description": "EXIF GPS position (GeoJSON)"
          },
          "thumbUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumburl"
          },
          "uploadedBy": {
            "format": "uuid",
            "title": "Uploadedby",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Public copy without EXIF/GPS; set once READY",
            "title": "Url"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          }
        },
        "required": [
          "id",
          "ownerService",
          "ownerType",
          "ownerId",
          "uploadedBy",
          "status",
          "contentType",
          "sizeBytes",
          "url",
          "thumbUrl",
          "width",
          "height",
          "exifTime",
          "isGeoVerified",
          "geoStatus",
          "distanceM",
          "rejectReason",
          "createdAt",
          "processedAt",
          "takenAt",
          "originalUrl"
        ],
        "title": "MediaInternalOut",
        "type": "object"
      },
